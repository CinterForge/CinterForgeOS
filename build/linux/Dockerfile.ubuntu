# Ubuntu AMD64 development userspace. This is separate from the Debian
# Cloudflare/FEX image and from the SteamOS ARM64 desktop disk.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN test "$(dpkg --print-architecture)" = amd64
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-venv python3-pip bash coreutils \
    procps file git curl dbus-x11 xvfb xauth openbox \
    libgl1 mesa-utils libgtk-3-0 libx11-6 \
    libglibmm-2.4-1t64 libgtkmm-2.4-1t64 libsigc++-2.0-0v5 \
    libjack-jackd2-0 libasound2t64 libpulse0 libsndfile1 \
    libsamplerate0 libfftw3-double3 librubberband2 liblo7 \
    libaubio5 libtag1v5 libarchive13t64 libxml2 libcurl4t64 \
    libudev1 libusb-1.0-0 libvamp-hostsdk3v5 && \
    rm -rf /var/lib/apt/lists/*

# Smaller, independently cached shared-application additions. Keep the stable
# Ubuntu baseline above byte-for-byte unchanged so updating application
# dependencies does not reinstall the entire base userspace.
RUN apt-get update && apt-get install -y --no-install-recommends \
    liblrdf0 liblilv-0-0 libsuil-0-0 libserd-0-0 libsord-0-0 libsratom-0-0 \
    jackd2 ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# All Linux applications share this installed userspace. Fail during the OS
# build, rather than discovering missing common C++ audio libraries in tests.
RUN ldconfig -p | grep -q 'libglibmm-2.4.so.1' && \
    ldconfig -p | grep -q 'libgtkmm-2.4.so.1' && \
    ldconfig -p | grep -q 'liblrdf.so.0' && \
    ldconfig -p | grep -q 'liblilv-0.so.0'
RUN mkdir -p /opt/cinterforge/Applications
ENV CINTER_APPLICATIONS_ROOT=/opt/cinterforge/Applications
WORKDIR /opt/cinterforge
CMD ["/bin/bash"]
