#!/bin/sh
set -eu
wallpaper=/usr/share/cinterforge/backgrounds/cinterforge-linux-1920x1080.png
[ -s "$wallpaper" ] || { echo "[CinterForgeOS] Missing wallpaper: $wallpaper" >&2; exit 1; }
config=/home/steamos/.config/plasma-org.kde.plasma.desktop-appletsrc
# Preserve the user's Plasma desktop layout; modify only wallpaper Image keys.
# KDE writes these settings in each [Containments][N][Wallpaper][org.kde.image][General] section.
if [ -f "$config" ]; then
    temp="${config}.cinterforge-tmp-$$"
    trap 'rm -f "$temp"' EXIT HUP INT TERM
    awk -v wallpaper="file://$wallpaper" '
      /^\[Containments\]\[[0-9]+\]\[Wallpaper\]\[org\.kde\.image\]\[General\]$/ { in_wallpaper=1; print; next }
      /^\[/ { in_wallpaper=0 }
      in_wallpaper && /^Image=/ { print "Image=" wallpaper; changed++; next }
      { print }
      END { if (!changed) exit 5 }
    ' "$config" > "$temp" || {
      echo "[CinterForgeOS] Existing Plasma config has no matching wallpaper section; preserving it" >&2
      rm -f "$temp"
      exit 0
    }
    chmod --reference="$config" "$temp"
    chown --reference="$config" "$temp"
    mv -f "$temp" "$config"
    trap - EXIT HUP INT TERM
    echo "[CinterForgeOS] Existing KDE wallpaper configured before login"
else
    # The system fallback replaces SteamOS' native default JPEG in the layer.
    echo "[CinterForgeOS] No existing Plasma wallpaper config; using staged system default"
fi
