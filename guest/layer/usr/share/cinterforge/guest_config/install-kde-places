#!/bin/sh
set -eu
home=/home/steamos
# CinterForge's live dispatcher is persistent user data in the Steam library.
# It is installed by the host Build -> Stage lifecycle, never during guest boot.
# This KDE preparation script must not create, modify, or replace that file.
places="$home/.local/share/user-places.xbel"
seed=/usr/share/cinterforge/kde/user-places.xbel
install -d -m 0755 -o steamos -g steamos "$home/.local/share"
# Install only the missing local entry point so Konsole users can type ./CinterForge.
# Never overwrite a user's existing ~/CinterForge file or link.
if [ ! -e "$home/CinterForge" ] && [ ! -L "$home/CinterForge" ]; then
    ln -s /usr/bin/CinterForge "$home/CinterForge"
    chown -h steamos:steamos "$home/CinterForge"
fi
# The sole host filesystem share is /run/steamapps. Do not create shadow shares.
# Four separate groups: staged CinterForge applications vs original publishers.
# The app menu uses categories while the desktop uses actual folders.
install -d -m 0755 /etc/xdg/menus/applications-merged
install -m 0644 /usr/share/cinterforge/kde/cinterforge-unforked.menu /etc/xdg/menus/applications-merged/cinterforge-unforked.menu
desktop="$home/Desktop"
install -d -m 0755 -o steamos -g steamos "$desktop"
# Fresh SteamOS disks start with no KDE desktop metadata. Regenerate only
# CinterForge-owned shortcuts on every SDDM initialization, including upgrades;
# leave unrelated user documents and launchers untouched.
install_folder_icon() {
    folder=$1
    label=$2
    icon=$3
    metadata="$folder/.directory"
    if [ -e "$metadata" ] && ! grep -Fxq 'X-CinterForgeOS-Managed=true' "$metadata"; then
        # Respect user-authored folder metadata; no replacement.
        return 0
    fi
    cat > "$metadata" <<EOF_CFOS_FOLDER
[Desktop Entry]
Type=Directory
Name=$label
Icon=$icon
X-CinterForgeOS-Managed=true
EOF_CFOS_FOLDER
    chmod 0644 "$metadata"
    chown steamos:steamos "$metadata"
    # Plasma desktop-folder label comes from the directory filename; the
    # .directory file supplies the matching KDE metadata. Keep both explicit.
    chmod 0755 "$folder"
}
install_managed_launcher() {
    src=$1
    dst=$2
    # Previously generated launchers may contain obsolete names or Exec paths.
    # Replace only launchers that identify themselves as CinterForge's, or
    # launchers that this script has already installed on earlier boots.
    if [ -L "$dst" ]; then
        case "$(readlink "$dst")" in
          /usr/share/applications/cinterforge-*.desktop) rm -f "$dst" ;;
          *) return 0 ;;
        esac
    fi
    if [ -f "$dst" ] && ! grep -Eq '^(X-CinterForgeOS-Managed=true|Exec=(CinterForge|/usr/bin/CinterForge) (launch-|install-))' "$dst"; then
        return 0
    fi
    # Preserve all authored application fields and mark our own copy for
    # deterministic refresh after the next SteamOS disk install/update.
    temp="${dst}.cfos-$$"
    cat "$src" > "$temp"
    printf '\nX-CinterForgeOS-Managed=true\n' >> "$temp"
    chmod 0755 "$temp"
    chown steamos:steamos "$temp"
    mv -f "$temp" "$dst"
}

for platform in Linux Windows; do
    lower=$(printf '%s' "$platform" | tr '[:upper:]' '[:lower:]')
    for flavor in built unforked; do
        if [ "$flavor" = built ]; then
            group="$desktop/CinterForge $platform"
        else
            group="$desktop/$platform Unforked"
        fi
        install -d -m 0755 -o steamos -g steamos "$group"
        if [ "$flavor" = built ]; then
            install_folder_icon "$group" "CinterForge $platform" /usr/share/cinterforge/icons/desktop.png
        else
            install_folder_icon "$group" "$platform Unforked" folder
        fi
        for app in GIMP Krita Inkscape Scribus Blender Kdenlive Ardour RapidRAW; do
            slug=$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')
            src="/usr/share/applications/cinterforge-$flavor-$lower-$slug.desktop"
            if [ "$flavor" = built ]; then
                case "$app" in
                    GIMP) product='CinterForge Image' ;; Krita) product='CinterForge Paint' ;;
                    Inkscape) product='CinterForge Vector' ;; Scribus) product='CinterForge Document' ;;
                    Blender) product='CinterForge 3D' ;; Kdenlive) product='CinterForge Video' ;;
                    Ardour) product='CinterForge Audio' ;; RapidRAW) product='CinterForge Photo' ;;
                esac
                # Remove only shortcuts previously produced under upstream names.
                legacy="$group/$app.desktop"
                if [ -f "$legacy" ] && grep -Fq "Exec=CinterForge launch-cinterforge $platform $app" "$legacy"; then
                    rm -f -- "$legacy"
                fi
                dst="$group/$product.desktop"
            else
                dst="$group/$app.desktop"
            fi
            [ -f "$src" ] || { echo "Missing KDE launcher: $src" >&2; exit 1; }
            install_managed_launcher "$src" "$dst"
        done
    done
done
# Install launchers for the two dedicated publisher installer groups.
for platform in Linux Windows; do
    lower=$(printf '%s' "$platform" | tr '[:upper:]' '[:lower:]')
    group="$desktop/$platform Install"
    install -d -m 0755 -o steamos -g steamos "$group"
    install_folder_icon "$group" "$platform Install" folder-download
    for app in GIMP Krita Inkscape Scribus Blender Kdenlive Ardour RapidRAW; do
        slug=$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')
        src="/usr/share/applications/cinterforge-install-$lower-$slug.desktop"
        dst="$group/$app.desktop"
        [ -f "$src" ] || { echo "Missing KDE installer launcher: $src" >&2; exit 1; }
        install_managed_launcher "$src" "$dst"
    done
done
# Retire the obsolete duplicate pair emitted by Support/desktop-ready.sh.
# These names were CinterForgeOS-owned; do not touch arbitrary desktop files.
for old in "CinterForgeOS Linux Heaven.desktop" "CinterForgeOS Windows Heaven.desktop"; do
    path="$desktop/$old"
    if [ -f "$path" ] && grep -Fq '.local/share/cinterforge/benchmark-launchers/' "$path"; then
        rm -f -- "$path"
    fi
done
# Built-in Heaven launchers live in the immutable OS layer, not in an
# ephemeral Konsole session. Copy their scripts into persistent user space
# on every boot so Xcode Build+Run provisions even a fresh SteamOS image.
# Preserve user-owned replacements; only refresh our managed copies.
demo_src=/usr/share/cinterforge/demo_launchers
demo_scripts="$home/.local/share/cinterforge/demo-launchers"
install -d -m 0755 -o steamos -g steamos "$demo_scripts"
for platform in Linux Windows; do
    lower=$(printf '%s' "$platform" | tr '[:upper:]' '[:lower:]')
    script="$demo_scripts/$lower-heaven.sh"
    source_script="$demo_src/$lower-heaven.sh"
    [ -s "$source_script" ] || { echo "Missing Heaven script: $source_script" >&2; exit 1; }
    if [ ! -e "$script" ] || grep -Fq '# X-CinterForgeOS-Managed=true' "$script"; then
        tmp="${script}.cfos-$$"
        cat "$source_script" > "$tmp"
        printf '\n# X-CinterForgeOS-Managed=true\n' >> "$tmp"
        chmod 0755 "$tmp"
        chown steamos:steamos "$tmp"
        mv -f "$tmp" "$script"
    fi
    source_entry="$demo_src/Heaven-$platform.desktop"
    # Use a new canonical basename for Windows to invalidate KDE's cached,
    # blank-label desktop item. Keep Linux Heaven's known-working shortcut.
    if [ "$platform" = Windows ]; then
        target="$desktop/Heaven Windows (Proton).desktop"
        legacy="$desktop/Heaven-Windows.desktop"
        if [ -f "$legacy" ] && grep -Eq '(X-CinterForgeOS-Managed=true|demo-launchers/windows-heaven.sh)' "$legacy"; then
            rm -f -- "$legacy"
        fi
    else
        target="$desktop/Heaven-$platform.desktop"
    fi
    [ -s "$source_entry" ] || { echo "Missing Heaven launcher: $source_entry" >&2; exit 1; }
    # Refresh only entries we own. Older one-off demo installer copies
    # have our script destination but no marker; detect them without
    # appending markers in-place on every boot.
    if [ -f "$target" ] && grep -Eq '(demo-launchers/|X-CinterForgeOS-Managed=true)' "$target"; then
        rm -f -- "$target"
    fi
    install_managed_launcher "$source_entry" "$target"
done
# The Plasma directory-view uses the icon declared in .directory; verify the
# branded artwork exists rather than silently shipping generic folders.
[ -s /usr/share/cinterforge/icons/desktop.png ] || {
    echo 'Missing CinterForge KDE folder icon' >&2
    exit 1
}
# Migrate old persistent Dolphin bookmarks without disturbing user-defined places.
if [ -f "$places" ]; then
    tmp=$(mktemp "${places}.cinterforge.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    # Remove only the two legacy bookmarks owned by CinterForgeOS.
    grep -v -e 'href="file:///run/Applications"' \
            -e 'href="file:///run/DeveloperTests"' "$places" > "$tmp" || true
    if ! grep -Fq 'file:///run/steamapps' "$tmp"; then
        sed -i '/<\/xbel>/i\  <bookmark href="file:///run/steamapps"><title>steamapps</title></bookmark>' "$tmp"
    fi
    chown steamos:steamos "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$places"
    trap - EXIT HUP INT TERM
else
    install -m 0644 -o steamos -g steamos "$seed" "$places"
fi
# Remove legacy root-level shadow link from earlier CinterForgeOS builds.
if [ -L /run/Applications ]; then
    case "$(readlink /run/Applications)" in
        /run/steamapps/common/CinterForge/Applications) rm -f /run/Applications ;;
    esac
fi
echo '[CinterForgeOS] Dolphin Places ready: steamapps only'
