#!/bin/sh
set -u
location=/run/steamapps
printf '[CinterForgeOS mounts] verifying sole Steam library share: %s\n' "$location"
timeout 15 ls -A "$location" >/dev/null || { echo '[CinterForgeOS mounts] ERROR: steamapps mount unavailable' >&2; exit 0; }
findmnt -rn --mountpoint "$location" -t virtiofs >/dev/null || { echo '[CinterForgeOS mounts] ERROR: steamapps is not virtiofs' >&2; exit 0; }
# Probe actual access using desktop credentials. Do not chmod the host library.
if ! runuser -u steamos -- test -r "$location" || ! runuser -u steamos -- test -x "$location"; then
    echo '[CinterForgeOS mounts] ERROR: steamos cannot read/traverse steamapps' >&2
    exit 0
fi
probe="$location/.cinterforge-steamapps-rwx-check"
if ! runuser -u steamos -- sh -c 'umask 077; : > "$1" && test -w "$1" && rm -f "$1"' sh "$probe"; then
    echo '[CinterForgeOS mounts] ERROR: steamapps is not writable by steamos (host permissions / VirtioFS ownership)' >&2
    exit 0
fi
printf '[CinterForgeOS mounts] PASS steamapps read/write/traverse for steamos\n'
