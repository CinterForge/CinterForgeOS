#!/bin/sh
# Launch a staged CinterForge app; never fall back to an original publisher install.
set -eu
[ "$#" -eq 2 ] || { echo 'Usage: launch-cinterforge <Linux|Windows> <app>' >&2; exit 2; }
platform=$1 app=$2
case "$platform" in Linux|Windows) ;; *) echo "Unsupported platform: $platform" >&2; exit 2 ;; esac
case "$app" in GIMP|Krita|Inkscape|Scribus|Blender|Kdenlive|Ardour|RapidRAW) ;; *) echo "Unknown app: $app" >&2; exit 2 ;; esac
# Branded products are installed under their own names, not upstream labels.
case "$app" in
 GIMP) product='CinterForge Image' ;; Krita) product='CinterForge Paint' ;;
 Inkscape) product='CinterForge Vector' ;; Scribus) product='CinterForge Document' ;;
 Blender) product='CinterForge 3D' ;; Kdenlive) product='CinterForge Video' ;;
 Ardour) product='CinterForge Audio' ;; RapidRAW) product='CinterForge Photo' ;;
esac
base="/run/steamapps/common/CinterForge/Applications/$platform/$product"
[ -d "$base" ] || { echo "CinterForge $platform $app is not staged: $base" >&2; exit 1; }
root=$(find "$base" -mindepth 1 -maxdepth 1 -type d -print | LC_ALL=C sort -V | tail -n 1)
[ -n "$root" ] || { echo "No installed version in $base" >&2; exit 1; }
if [ "$app" = Ardour ]; then
    if [ "$platform" = Linux ]; then exec /usr/lib/cinterforge/launch-ardour-linux "$root"; fi
    exec /usr/lib/cinterforge/launch-ardour-windows "$root"
fi
case "$app" in GIMP) exe=gimp ;; Krita) exe=krita ;; Inkscape) exe=inkscape ;;
 Scribus) exe=scribus ;; Blender) exe=blender ;; Kdenlive) exe=kdenlive ;; RapidRAW) exe=rapidraw ;; esac
if [ "$platform" = Linux ]; then
    # Only launch a real executable in the installed app's bin hierarchy.
    for candidate in "$root/bin/$exe" "$root/usr/bin/$exe" "$root/$exe"; do
        if [ -f "$candidate" ] && [ -x "$candidate" ]; then
            exec /usr/lib/cinterforge/run-linux-amd64 "$candidate"
        fi
    done
else
    for candidate in "$root/bin/$exe.exe" "$root/$exe.exe" "$root/$app.exe"; do
        if [ -f "$candidate" ]; then
            export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/cinterforge/wine-built-$app}"
            mkdir -p "$WINEPREFIX"
            exec /usr/lib/cinterforge/cinterforge-wine "$candidate"
        fi
    done
fi
echo "CinterForge $platform $app executable missing under $root (staging must provide a launchable binary)." >&2
exit 1
