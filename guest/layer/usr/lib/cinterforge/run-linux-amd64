#!/bin/sh
set -eu
[ "$#" -ge 1 ] || { echo 'Usage: run-linux-amd64 <installed executable> [args...]' >&2; exit 2; }
[ -f "$1" ] && [ -x "$1" ] || { echo "Installed application executable missing: $1" >&2; exit 1; }
case "$(uname -m)" in
    x86_64) exec "$@" ;;
    aarch64|arm64)
        command -v FEX >/dev/null 2>&1 || {
            echo 'FEX emulator missing: the bundled FEXBash wrapper is not an installed FEX runtime.' >&2
            echo 'Run /usr/lib/cinterforge/inspect-x86-runtime for specific missing components.' >&2
            exit 1
        }
        # Do not rely on a per-user FEXConfig created on first run.
        # The distribution-owned amd64 RootFS is staged in the layer.
        FEX_ROOTFS=/usr/share/cinterforge/fex/RootFS
        [ -e "$FEX_ROOTFS/usr/lib/x86_64-linux-gnu/libglib-2.0.so.0" ] || {
            echo "FEX amd64 RootFS missing GLib: $FEX_ROOTFS" >&2
            echo 'Rebuild the CinterForgeOS FEX userspace and layer.' >&2
            exit 1
        }
        export FEX_ROOTFS
        exec FEX "$@" ;;
    *) echo "Unsupported SteamOS host architecture: $(uname -m)" >&2; exit 1 ;;
esac
