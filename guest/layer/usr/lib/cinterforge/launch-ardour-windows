#!/bin/sh
# Installed Windows x64 CinterForge Audio through Wine (FEX where needed).
set -eu
base='/run/Applications/Windows/CinterForge Audio'
if [ "$#" -gt 0 ] && [ -d "$1" ]; then root=$1; shift
else
    [ -d "$base" ] || { echo "Windows CinterForge Audio installation missing: $base" >&2; exit 1; }
    root=$(find "$base" -mindepth 1 -maxdepth 1 -type d -print | LC_ALL=C sort -V | tail -n 1)
fi
[ -n "${root:-}" ] && [ -d "$root" ] || { echo "No installed Windows version under $base" >&2; exit 1; }
engine=
for candidate in "$root"/bin/ardour9.exe "$root"/bin/Ardour*.exe "$root"/lib/ardour9/ardour-[0-9]*.exe; do
    [ -f "$candidate" ] || continue
    engine=$candidate
    break
done
[ -n "$engine" ] || { echo "Windows Ardour executable missing in $root/bin or $root/lib/ardour9" >&2; ls -la "$root/bin" "$root/lib/ardour9" >&2 2>/dev/null || true; exit 1; }
command -v wine >/dev/null 2>&1 || { echo 'Wine is not installed in this SteamOS guest. Windows Ardour requires Wine (and FEX on ARM64).' >&2; exit 1; }
export WINEARCH=win64
export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/cinterforge/wine-ardour}"
mkdir -p "$WINEPREFIX"
printf '[CinterForgeOS] Windows Ardour: %s\n' "$engine" >&2
exec wine "$engine" "$@"
