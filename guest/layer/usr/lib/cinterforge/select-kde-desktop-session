#!/bin/sh
set -eu
# SteamOS may select Gaming Mode from /etc/sddm.conf after reading conf.d.
# Set the effective SDDM autologin settings in the highest-precedence file.
session=/usr/share/wayland-sessions/plasma.desktop
if [ ! -f "$session" ]; then
    echo "[CinterForgeOS] ERROR: native Plasma Wayland session missing: $session" >&2
    exit 1
fi
install -d -m 0755 /etc/sddm.conf.d
printf '[Autologin]\nUser=steamos\nSession=plasma.desktop\n' > /etc/sddm.conf.d/zzzz-cinterforgeos-desktop.conf
# /etc/sddm.conf has higher precedence than /etc/sddm.conf.d/*.conf.
# Preserve all other display-manager configuration, replacing only the
# existing Autologin section instead of clobbering it.
config=/etc/sddm.conf
if [ -f "$config" ]; then
    tmp=$(mktemp "${config}.cinterforge.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    awk '
      /^\[Autologin\]$/ { in_autologin=1; next }
      /^\[/ { in_autologin=0 }
      !in_autologin { print }
    ' "$config" > "$tmp"
    printf '
[Autologin]
User=steamos
Session=plasma.desktop
' >> "$tmp"
    cat "$tmp" > "$config"
    rm -f "$tmp"
    trap - EXIT HUP INT TERM
else
    printf '[Autologin]
User=steamos
Session=plasma.desktop
' > "$config"
fi
echo "[CinterForgeOS] SDDM autologin selected native KDE Plasma desktop"
