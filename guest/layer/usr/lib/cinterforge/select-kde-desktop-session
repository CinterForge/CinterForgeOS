#!/bin/sh
set -eu
# A previous CinterForgeOS release installed a desktop override into the
# persistent SteamOS root. Removing it from EROFS alone cannot remove the
# systemd enablement from the retained disk. Retire it on the real guest root.
# Retire both earlier CinterForge boot mechanisms from persistent SteamOS.
# The sole entry point is now SDDM ExecStartPre -> KDE per-user Autostart.
for retired in cinterforge-desktop-default.service; do
    rm -f "/etc/systemd/system/$retired"           "/etc/systemd/system/multi-user.target.wants/$retired"           "/etc/systemd/system/graphical.target.wants/$retired"
done
legacy=cinterforge-desktop-default.service
if [ -e "/etc/systemd/system/$legacy" ] || [ -L "/etc/systemd/system/$legacy" ]; then
    rm -f "/etc/systemd/system/$legacy"
fi
if [ -e "/etc/systemd/system/graphical.target.wants/$legacy" ] || [ -L "/etc/systemd/system/graphical.target.wants/$legacy" ]; then
    rm -f "/etc/systemd/system/graphical.target.wants/$legacy"
fi
# Prevent an older /usr unit in the persistent A/B root from being started
# again. Only the retired CinterForge unit is masked; SDDM remains enabled.
ln -s /dev/null "/etc/systemd/system/$legacy"
systemctl daemon-reload
# SteamOS may select Gaming Mode from /etc/sddm.conf after reading conf.d.
# Set the effective SDDM autologin settings in the highest-precedence file.
session=/usr/share/wayland-sessions/plasma.desktop
if [ ! -f "$session" ]; then
    echo "[CinterForgeOS] ERROR: native Plasma Wayland session missing: $session" >&2
    exit 1
fi
install -d -m 0755 /etc/sddm.conf.d
printf '[Autologin]\nUser=steamos\nSession=plasma.desktop\n' > /etc/sddm.conf.d/zzzz-cinterforgeos-desktop.conf
# /etc/sddm.conf has higher precedence than /etc/sddm.conf.d/*.conf.
# Preserve all other display-manager configuration, replacing only the
# existing Autologin section instead of clobbering it.
config=/etc/sddm.conf
if [ -f "$config" ]; then
    tmp=$(mktemp "${config}.cinterforge.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    # Parse INI sections without bracket regex escaping (the previous guest
    # layer generated an invalid awk expression and prevented SDDM startup).
    awk '
      substr($0, 1, 1) == "[" && substr($0, length($0), 1) == "]" {
          in_autologin = ($0 == "[Autologin]")
          next
      }
      !in_autologin { print }
    ' "$config" > "$tmp"
    printf '
[Autologin]
User=steamos
Session=plasma.desktop
' >> "$tmp"
    cat "$tmp" > "$config"
    rm -f "$tmp"
    trap - EXIT HUP INT TERM
else
    printf '[Autologin]
User=steamos
Session=plasma.desktop
' > "$config"
fi
# SteamOS disk provisioning can leave the persistent /home/steamos tree
# owned by root. SDDM autologin succeeds but every KDE component then fails
# to write ~/.config, leaving a black desktop with repeated dialogs.
# Repair ownership on the actual mounted home, BEFORE starting SDDM.
# Never chmod 777, replace the home filesystem, or modify the disk image.
home=/home/steamos
if ! mountpoint -q /home; then
    echo "[CinterForgeOS] ERROR: persistent /home is not mounted; refusing to start KDE" >&2
    exit 1
fi
if ! findmnt -n -o OPTIONS --target "$home" | tr , '
' | grep -qx rw; then
    echo "[CinterForgeOS] ERROR: persistent SteamOS home is read-only; check filesystem health" >&2
    exit 1
fi
install -d -m 0755 -o steamos -g steamos "$home"
chown steamos:steamos "$home"
chmod u+rwx "$home"
install -d -m 0700 -o steamos -g steamos "$home/.config"
# Existing Plasma configuration may have been written as root by earlier
# installers. Confine corrective ownership to the user configuration tree.
chown -R steamos:steamos "$home/.config"
chmod u+rwx "$home/.config"
if ! runuser -u steamos -- sh -c 'test -w "$1" && test -w "$1/.config" && : > "$1/.config/.cinterforge-write-probe" && rm "$1/.config/.cinterforge-write-probe"' sh "$home"; then
    echo "[CinterForgeOS] ERROR: KDE home remains unwritable for steamos" >&2
    exit 1
fi
echo "[CinterForgeOS] Verified persistent KDE home and ~/.config writable by steamos"
    # Native Dolphin Places bookmarks, not pseudo block devices. Preserve
    # existing user bookmarks; only add the two CinterForge entries once.
    # They are visible even when a share is unavailable, making failures obvious.
    places="$home/.local/share/user-places.xbel"
    install -d -m 0755 -o steamos -g steamos "$home/.local/share"
    if [ ! -f "$places" ]; then
        cat > "$places" <<'CFOS_PLACES'
<?xml version="1.0" encoding="UTF-8"?>
<xbel version="1.0" xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">
</xbel>
CFOS_PLACES
    fi
    for name in Applications DeveloperTests; do
        # Use the exact href, not a matching title that a user may rename.
        if ! grep -Fq "file:///run/$name" "$places"; then
            temp=$(mktemp "${places}.cinterforge.XXXXXX")
            awk -v name="$name" '
                /<\/xbel>/ && !inserted {
                    print "  <bookmark href=" sprintf("%c", 34) "file:///run/" name sprintf("%c", 34) "><title>" name "</title></bookmark>"
                    inserted=1
                }
                { print }
                END { if (!inserted) exit 1 }
            ' "$places" > "$temp" || {
                rm -f "$temp"
                echo "[CinterForgeOS] ERROR: cannot update Dolphin Places XML: $places" >&2
                exit 1
            }
            cat "$temp" > "$places"
            rm -f "$temp"
        fi
    done
    chown steamos:steamos "$places"
    chmod 0644 "$places"
    echo "[CinterForgeOS] Dolphin Places: Applications and DeveloperTests available"
    # Plasma has separate application and script autostart mechanisms. Keep
    # a fallback startup script for SteamOS versions that skip XDG desktop
    # entries; the bridge itself holds a single-process flock lock.
    scripts="$home/.config/autostart-scripts"
    install -d -m 0755 -o steamos -g steamos "$scripts"
    cat > "$scripts/cinterforge-installed-test.sh" <<'CFOS_SCRIPT_AUTOSTART'
#!/bin/sh
exec /usr/lib/cinterforge/installed-app-gui-test
CFOS_SCRIPT_AUTOSTART
    chmod 0755 "$scripts/cinterforge-installed-test.sh"
    chown steamos:steamos "$scripts/cinterforge-installed-test.sh"
# Install a true per-user KDE Autostart entry in the persistent SteamOS
# home directory. System-wide /usr/share/xdg/autostart may be filtered or
# overridden by existing Plasma settings; this is the path used by KDE's
# Settings > Autostart > Add Application workflow. No second desktop is run.
autostart=/home/steamos/.config/autostart
install -d -m 0755 -o steamos -g steamos "$autostart"
cat > "$autostart/cinterforge-installed-test.desktop" <<'CFOS_AUTOSTART'
[Desktop Entry]
Type=Application
Name=CinterForgeOS KDE guest smoke bridge
Exec=/usr/lib/cinterforge/installed-app-gui-test
Terminal=false
X-KDE-autostart-phase=2
CFOS_AUTOSTART
chmod 0644 "$autostart/cinterforge-installed-test.desktop"
chown steamos:steamos "$autostart/cinterforge-installed-test.desktop"
echo "[CinterForgeOS] Installed native per-user KDE Autostart for steamos"
# Native KDE bypasses the old gamescope-session.target/steam.service path.
# Restore Steam's sign-in UI in the real Plasma session, without nesting a
# second desktop or relying on systemctl --user (which may have no user bus).
# Reinstall on each boot because /home is persistent across guest layer updates.
cat > "$autostart/cinterforge-steam.desktop" <<'CFOS_STEAM_AUTOSTART'
[Desktop Entry]
Type=Application
Name=Steam
Comment=Steam sign-in and desktop client
Exec=/usr/lib/steamac/steam-kde-login
Icon=steam
Terminal=false
OnlyShowIn=KDE
X-KDE-autostart-phase=1
CFOS_STEAM_AUTOSTART
chmod 0644 "$autostart/cinterforge-steam.desktop"
chown steamos:steamos "$autostart/cinterforge-steam.desktop"
echo '[CinterForgeOS] Steam ARM64 KDE sign-in autostart installed for steamos'
echo "[CinterForgeOS] SDDM autologin selected native KDE Plasma desktop"
