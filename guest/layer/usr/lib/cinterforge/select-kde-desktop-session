#!/bin/sh
set -eu
# A previous CinterForgeOS release installed a desktop override into the
# persistent SteamOS root. Removing it from EROFS alone cannot remove the
# systemd enablement from the retained disk. Retire it on the real guest root.
# Retire both earlier CinterForge boot mechanisms from persistent SteamOS.
# The sole entry point is now SDDM ExecStartPre -> KDE per-user Autostart.
for retired in cinterforge-desktop-default.service; do
    rm -f "/etc/systemd/system/$retired"           "/etc/systemd/system/multi-user.target.wants/$retired"           "/etc/systemd/system/graphical.target.wants/$retired"
done
legacy=cinterforge-desktop-default.service
if [ -e "/etc/systemd/system/$legacy" ] || [ -L "/etc/systemd/system/$legacy" ]; then
    rm -f "/etc/systemd/system/$legacy"
fi
if [ -e "/etc/systemd/system/graphical.target.wants/$legacy" ] || [ -L "/etc/systemd/system/graphical.target.wants/$legacy" ]; then
    rm -f "/etc/systemd/system/graphical.target.wants/$legacy"
fi
# Prevent an older /usr unit in the persistent A/B root from being started
# again. Only the retired CinterForge unit is masked; SDDM remains enabled.
ln -s /dev/null "/etc/systemd/system/$legacy"
systemctl daemon-reload
# SteamOS may select Gaming Mode from /etc/sddm.conf after reading conf.d.
# Set the effective SDDM autologin settings in the highest-precedence file.
# SteamOS's plasma.desktop can be replaced by session-selection packages or
# retained rootfs configuration. Use our explicit Plasma Desktop Mode entry,
# which starts plasma-session.target (never gamescope-session.target / Steam).
# SteamOS may expose only the stock Plasma Wayland session in the overlay.
# Never prevent SDDM from starting because an optional branded .desktop file
# is absent from the generated image (this previously stranded the guest at
# a text login after an ordinary Xcode Clean & Build).
session_name=cinterforgeos.desktop
session=/usr/share/wayland-sessions/$session_name
if [ ! -f "$session" ] || ! grep -Fxq 'Exec=/usr/bin/start-gamescope-session plasma-session.target' "$session"; then
    echo "[CinterForgeOS] WARNING: $session unavailable; selecting installed Plasma desktop session" >&2
    session_name=plasma.desktop
    session=/usr/share/wayland-sessions/$session_name
    if [ ! -f "$session" ]; then
        echo "[CinterForgeOS] ERROR: neither CinterForgeOS nor stock Plasma session exists" >&2
        exit 1
    fi
fi
install -d -m 0755 /etc/sddm.conf.d
printf '[Autologin]\nUser=steamos\nSession=%s\n' "$session_name" > /etc/sddm.conf.d/zzzz-cinterforgeos-desktop.conf
# /etc/sddm.conf has higher precedence than /etc/sddm.conf.d/*.conf.
# Preserve all other display-manager configuration, replacing only the
# existing Autologin section instead of clobbering it.
config=/etc/sddm.conf
if [ -f "$config" ]; then
    tmp=$(mktemp "${config}.cinterforge.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    # Parse INI sections without bracket regex escaping (the previous guest
    # layer generated an invalid awk expression and prevented SDDM startup).
    awk '
      substr($0, 1, 1) == "[" && substr($0, length($0), 1) == "]" {
          in_autologin = ($0 == "[Autologin]")
          next
      }
      !in_autologin { print }
    ' "$config" > "$tmp"
    printf '\n[Autologin]\nUser=steamos\nSession=%s\n' "$session_name" >> "$tmp"
    cat "$tmp" > "$config"
    rm -f "$tmp"
    trap - EXIT HUP INT TERM
else
    printf '[Autologin]\nUser=steamos\nSession=%s\n' "$session_name" > "$config"
fi
# SteamOS disk provisioning can leave the persistent /home/steamos tree
# owned by root. SDDM autologin succeeds but every KDE component then fails
# to write ~/.config, leaving a black desktop with repeated dialogs.
# Repair ownership on the actual mounted home, BEFORE starting SDDM.
# Never chmod 777, replace the home filesystem, or modify the disk image.
home=/home/steamos
if ! mountpoint -q /home; then
    echo "[CinterForgeOS] ERROR: persistent /home is not mounted; refusing to start KDE" >&2
    exit 1
fi
if ! findmnt -n -o OPTIONS --target "$home" | tr , '\n' | grep -qx rw; then
    echo "[CinterForgeOS] ERROR: persistent SteamOS home is read-only; check filesystem health" >&2
    exit 1
fi
install -d -m 0755 -o steamos -g steamos "$home"
chown steamos:steamos "$home"
chmod u+rwx "$home"
install -d -m 0700 -o steamos -g steamos "$home/.config"
# Existing Plasma configuration may have been written as root by earlier
# installers. Confine corrective ownership to the user configuration tree.
chown -R steamos:steamos "$home/.config"
chmod u+rwx "$home/.config"
if ! runuser -u steamos -- sh -c 'test -w "$1" && test -w "$1/.config" && : > "$1/.config/.cinterforge-write-probe" && rm "$1/.config/.cinterforge-write-probe"' sh "$home"; then
    echo "[CinterForgeOS] ERROR: KDE home remains unwritable for steamos" >&2
    exit 1
fi
echo "[CinterForgeOS] Verified persistent KDE home and ~/.config writable by steamos"
# A previous experimental workaround wrote KDE Qt Quick/KWin renderer
# overrides into the persistent home.  KWIN_COMPOSE=Q is not an appropriate
# compositor selection for this nested Plasma Wayland session.  Remove only
# our own override; never change the user's other session settings.
legacy_compositor="$home/.config/plasma-workspace/env/50-cinterforgeos-compositor.sh"
if [ -f "$legacy_compositor" ]; then
    if grep -Fq 'QT_QUICK_BACKEND=software' "$legacy_compositor" && \
       grep -Fq 'KWIN_COMPOSE=Q' "$legacy_compositor"; then
        rm -f "$legacy_compositor"
        echo '[CinterForgeOS] Removed obsolete KDE compositor override from persistent home'
    else
        echo '[CinterForgeOS] WARNING: compositor override has user modifications; leaving it intact' >&2
    fi
fi
# Enable native Plasma previous-session restore on first setup. Respect a
# user-selected setting (e.g. empty session or manually saved session).
# Session state lives in the existing persistent /home/steamos; it is never
# written to the disposable image or the host Steam library.
session_config="$home/.config/ksmserverrc"
if ! grep -Eq '^[[:space:]]*loginMode[[:space:]]*=' "$session_config" 2>/dev/null; then
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        runuser -u steamos -- kwriteconfig6 --file ksmserverrc --group General --key loginMode restorePreviousLogout
    elif command -v kwriteconfig5 >/dev/null 2>&1; then
        runuser -u steamos -- kwriteconfig5 --file ksmserverrc --group General --key loginMode restorePreviousLogout
    else
        echo '[CinterForgeOS] WARNING: kwriteconfig missing; configure Plasma session restore via System Settings' >&2
    fi
    echo '[CinterForgeOS] Plasma session restore: previous logout (unless user overrides)'
fi
# Keep user-authored Places intact. For fresh home directories copy the
# version-controlled XBEL seed; for existing users append only missing entries.
/usr/lib/cinterforge/install-kde-places
# One authored KDE autostart entry. No competing script fallback.
autostart="$home/.config/autostart"
install -d -m 0755 -o steamos -g steamos "$autostart"
install -m 0644 -o steamos -g steamos /usr/share/cinterforge/kde/cinterforge-installed-test.desktop "$autostart/cinterforge-installed-test.desktop"
echo "[CinterForgeOS] Installed authored KDE autostart entry"
# Steam must not start automatically in the native KDE session. On SteamOS,
# the Deck client can initiate a Gamescope/Gaming Mode session transition;
# that terminates the SDDM Plasma login and makes the desktop disappear.
# Remove the autostart entry installed by earlier CinterForgeOS layers from
# persistent /home, but preserve the Steam client and all account data.
rm -f "$autostart/cinterforge-steam.desktop"
# Shadow both SteamOS global and earlier layer-provided Steam XDG autostarts.
# Hidden=true disables matching system entries without removing the Steam app.
cat > "$autostart/steam.desktop" <<'CFOS_DISABLE_STEAM_AUTOSTART'
[Desktop Entry]
Type=Application
Name=Steam
Hidden=true
CFOS_DISABLE_STEAM_AUTOSTART
chmod 0644 "$autostart/steam.desktop"
chown steamos:steamos "$autostart/steam.desktop"
# Provide an explicit, user-launchable Steam entry instead of starting it
# during session establishment. This is not an XDG autostart directory.
applications="$home/.local/share/applications"
install -d -m 0755 -o steamos -g steamos "$applications"
cat > "$applications/cinterforge-steam.desktop" <<'CFOS_STEAM_LAUNCHER'
[Desktop Entry]
Type=Application
Name=Steam (CinterForgeOS)
Comment=Launch the native Steam client from KDE
Exec=/usr/lib/steamac/steam-kde-login
Icon=steam
Terminal=false
Categories=Game;
CFOS_STEAM_LAUNCHER
chown steamos:steamos "$applications/cinterforge-steam.desktop"
chmod 0644 "$applications/cinterforge-steam.desktop"
# Linux Ardour is an ELF application, not a Proton/Steam shortcut. Expose the
# installed GUI launcher in KDE and on the desktop. It invokes the existing
# Linux x86-64 FEX runner directly and cannot trigger a SteamOS mode switch.
cat > "$applications/cinterforge-audio-linux.desktop" <<'CFOS_ARDOUR_LINUX'
[Desktop Entry]
Type=Application
Name=CinterForge Audio (Linux)
Comment=Launch installed Linux x86-64 Ardour on the KDE desktop
Exec=/usr/lib/cinterforge/launch-ardour-linux
Icon=audio-x-generic
Terminal=true
Categories=AudioVideo;Audio;AudioVideoEditing;
StartupNotify=true
CFOS_ARDOUR_LINUX
chmod 0644 "$applications/cinterforge-audio-linux.desktop"
chown steamos:steamos "$applications/cinterforge-audio-linux.desktop"
desktop="$home/Desktop"
install -d -m 0755 -o steamos -g steamos "$desktop"
install -m 0755 -o steamos -g steamos "$applications/cinterforge-audio-linux.desktop" "$desktop/cinterforge-audio-linux.desktop"
# Windows Ardour runs as a KDE window through the existing Wine/FEX guest
# launcher, never as a Steam shortcut or a Gaming Mode transition.
cat > "$applications/cinterforge-audio-windows.desktop" <<'CFOS_ARDOUR_WINDOWS'
[Desktop Entry]
Type=Application
Name=Ardour (Windows)
Comment=Launch installed Windows x64 Ardour on the KDE desktop
Exec=/usr/lib/cinterforge/launch-ardour-windows
Icon=audio-x-generic
Terminal=true
Categories=AudioVideo;Audio;AudioVideoEditing;
StartupNotify=true
CFOS_ARDOUR_WINDOWS
chmod 0644 "$applications/cinterforge-audio-windows.desktop"
chown steamos:steamos "$applications/cinterforge-audio-windows.desktop"
install -m 0755 -o steamos -g steamos "$applications/cinterforge-audio-windows.desktop" "$desktop/cinterforge-audio-windows.desktop"
echo '[CinterForgeOS] Installed direct Windows Ardour KDE/desktop launcher (Wine/FEX, no Steam)'
echo '[CinterForgeOS] Installed direct Linux Ardour KDE/desktop launcher (no Steam or Proton)'
echo '[CinterForgeOS] Native Steam launcher available; Steam autostart disabled to protect KDE session'
echo '[CinterForgeOS] SDDM autologin selected explicit CinterForgeOS Plasma Desktop Mode (not Steam Gaming Mode)'
