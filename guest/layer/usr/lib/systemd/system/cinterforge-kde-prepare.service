[Unit]
Description=Select native CinterForgeOS KDE Plasma desktop
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service sddm.service graphical.target
[Service]
Type=oneshot
ExecStart=/usr/lib/cinterforge/select-kde-desktop-session
ExecStart=/usr/lib/cinterforge/select-kde-wallpaper
[Install]
WantedBy=multi-user.target
