#!/bin/bash
# The existing installer bundle owns the complete UI and Steam preflight.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd -P)"
BUNDLE="$(cd "$HERE/../.." && pwd -P)"
UI="$BUNDLE/Contents/Resources/UI"
DIALOG="$UI/steam_dialogs.applescript"
# The installer is inside the checkout. Resolve its parent directly; never
# require a machine-specific location or a Finder environment variable.
ROOT="$(cd "$BUNDLE/.." && pwd -P)"
if [[ ! -f "$ROOT/Install-CinterForgeOS.sh" || ! -d "$ROOT/build" ]]; then
  /usr/bin/osascript -e 'display alert "CinterForgeOS installer source not found" message "The installer must be inside the CinterForgeOS checkout, alongside Install-CinterForgeOS.sh and build/."' || true
  exit 1
fi
if [[ ! -f "$ROOT/CFOS" ]]; then
  /usr/bin/osascript -e 'display alert "CinterForgeOS lifecycle entry point missing" message "The checkout is missing CFOS. Restore that file from the repository; the installer cannot run Setup, Build, and Stage without it."' || true
  exit 1
fi
# Launch the same shell installer used successfully from Terminal.  Run the
# Steam account dialog there as part of that workflow, so Python does not
# inherit the Finder-launched .app's restricted volume-access context.
quoted_root=$(printf '%q' "$ROOT")
command="cd $quoted_root && CFOS_INSTALL_DIALOG=1 /bin/bash ./Install-CinterForgeOS.sh"
quoted_command=$(printf '%s' "$command" | /usr/bin/sed 's/\\/\\\\/g;s/"/\\"/g')
/usr/bin/osascript -e 'tell application "Terminal" to activate' -e "tell application \"Terminal\" to do script \"$quoted_command\""
