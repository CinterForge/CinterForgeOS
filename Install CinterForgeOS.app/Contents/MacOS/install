#!/bin/bash
# Run the existing CFOS installer directly in this app's process tree.
# Do not hand off to Terminal: Terminal may have a different removable-volume
# authorization context from the Finder-launched installer.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd -P)"
BUNDLE="$(cd "$HERE/../.." && pwd -P)"
ROOT="$(cd "$BUNDLE/.." && pwd -P)"
alert() {
  /usr/bin/osascript -e 'on run argv' -e 'display alert (item 1 of argv) message (item 2 of argv)' -e 'end run' -- "$1" "$2" || true
}
if [[ ! -r "$ROOT/Install-CinterForgeOS.sh" || ! -r "$ROOT/CFOS" || ! -d "$ROOT/build" ]]; then
  alert 'CinterForgeOS installer source unavailable' "Cannot read installer files in $ROOT. Grant removable-volume access to Install CinterForgeOS in System Settings, then reopen the app."
  exit 1
fi
# Resolve log location outside the source checkout, including when Steam has
# not been installed yet. The existing shell installer maintains its own
# installed-app log after the Steam preflight.
WORK="$ROOT/../Builds/CFOS/Installer"
mkdir -p "$WORK"
LOG="$WORK/installer-launch.log"
printf '\n=== Installer launched: %s ===\n' "$(date)" >> "$LOG"
/usr/bin/osascript -e 'display notification "Installation is running. Details are recorded in Builds/CFOS/Installer." with title "CinterForgeOS Installer"' || true
# Preserve the existing Steam-account dialog and Setup -> Build -> Stage
# lifecycle. This child remains under the app process, not Terminal.
set +e
(
  cd "$ROOT"
  CFOS_INSTALL_DIALOG=1 CFOS_PLAIN_OUTPUT=1 /bin/bash ./Install-CinterForgeOS.sh
) >> "$LOG" 2>&1
status=$?
set -e
if (( status != 0 )); then
  alert 'CinterForgeOS installation failed' "Exit status $status. See $LOG for the full error."
  exit "$status"
fi
alert 'CinterForgeOS installed' 'Setup, Build, and Stage completed successfully.'
